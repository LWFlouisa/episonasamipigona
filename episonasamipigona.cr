module WordSelection
  class Objects
    def self.gendered_object(masculine_object, feminine_object, neuter_object)
      a = masculine_object
      b = feminine_object
      c = neuter_object

      matrix = [
        [[a, a, a],
         [a, a, b],
         [a, a, c]],

        [[b, b, a],
         [b, b, b],
         [b, b, c]],

        [[c, c, a],
         [c, c, b],
         [c, c, c]],
      ]

      row_options = [0, 1, 2]
      col_options = [0, 1, 2]
      arr_options = [0, 1, 2]

      cur_row = row_options.sample
      cur_col = col_options.sample
      cur_arr = arr_options.sample

      new_gobject = matrix[cur_row][cur_col][cur_arr]

      new_gobject
    end

    def self.non_gendered(object_one, object_two, object_three)
      a = object_one
      b = object_two
      c = object_three

      matrix = [
        [[a, a, a],
         [a, a, b],
         [a, a, c]],

        [[b, b, a],
         [b, b, b],
         [b, b, c]],

        [[c, c, a],
         [c, c, b],
         [c, c, c]],
      ]

      row_options = [0, 1, 2]
      col_options = [0, 1, 2]
      arr_options = [0, 1, 2]

      cur_row = row_options.sample
      cur_col = col_options.sample
      cur_arr = arr_options.sample

      new_ngobject = matrix[cur_row][cur_col][cur_arr]

      new_ngobject
    end
  end

  class Subjects
    def self.shuffle_subjects(subject_one, subject_two, subject_tre)
      a = subject_one
      b = subject_two
      c = subject_tre

      matrix = [
        [[a, a, a],
         [a, a, b],
         [a, a, c]],

        [[b, b, a],
         [b, b, b],
         [b, b, c]],

        [[c, c, a],
         [c, c, b],
         [c, c, c]],
      ]

      row_options = [0, 1, 2]
      col_options = [0, 1, 2]
      arr_options = [0, 1, 2]

      cur_row = row_options.sample
      cur_col = col_options.sample
      cur_arr = arr_options.sample

      new_subject = matrix[cur_row][cur_col][cur_arr]

      new_subject
    end
  end

  class Verbs
    def self.shuffle_verbs(verb_one, verb_two, verb_tre)
      a = verb_one
      b = verb_two
      c = verb_tre

      matrix = [
        [[a, a, a],
         [a, a, b],
         [a, a, c]],

        [[b, b, a],
         [b, b, b],
         [b, b, c]],

        [[c, c, a],
         [c, c, b],
         [c, c, c]],
      ]

      row_options = [0, 1, 2]
      col_options = [0, 1, 2]
      arr_options = [0, 1, 2]

      cur_row = row_options.sample
      cur_col = col_options.sample
      cur_arr = arr_options.sample

      new_verb = matrix[cur_row][cur_col][cur_arr]

      new_verb
    end
  end
end

class EpisonasamipigonaREPL
  #######################################################################################
  #                                        REPL                                         #
  #######################################################################################
  def self.repl
    file_name = ARGV[0]

    read_file = File.read_lines(file_name)

    total_lines = read_file.size.to_i
    index       = 0

    if total_lines > 0
      total_lines.times do
        current_line = read_file[index]
  
        tokens       = current_line.split(" ")
        total_tokens = tokens.size.to_i
        token_index  = 0
    
        ## The actual tokens you'll be parsing.
        parsed_tokens = [] of String
    
        if total_tokens > 0

          total_tokens.times do
            current_token = tokens[token_index]
 
            parsed_tokens = parsed_tokens.push(current_token)
    
            token_index = token_index + 1
          end
        
          ###################################################################################################
          #                                         Document Parsing                                        #
          ###################################################################################################  
          if    parsed_tokens[0] == "encrire"
            new_index  = 0
            size_limit = parsed_tokens.size.to_i
          
            size_limit.times do
              new_output = parsed_tokens[new_index].tr "'", ""
            
              if new_output == "encrire"
              else
                print "#{new_output} "
              end
            
              new_index = new_index + 1
            end
          elsif parsed_tokens[0] == "encrireln"
            new_index  = 0
            size_limit = parsed_tokens.size.to_i
          
            size_limit.times do
              new_output = parsed_tokens[new_index].tr "'", ""
            
              if new_output == "encrireln"
              else
                print "#{new_output} "
              end
            
              new_index = new_index + 1
            end
          
            puts " "
          elsif parsed_tokens[0] == "#"
          elsif parsed_tokens[0] == "--"
          elsif parsed_tokens[0] == ""
          elsif parsed_tokens[0] == "ohang"
            puts "     *#**     "
            puts "  ****#*****"
            puts "******#*******"
            puts "******X======*"
            puts "**************"
            puts "  **********  "
            puts "     ****     "
            system("date")
            poem = <<-HEREDOC
            The moonlight hangs
            over the vanity glass...
            lamp overhangs.

            To think in this cold weather,
            when the wind chills,
            the willow beckons the sparrow,
            while running cold does the marrow.

            And the hour, the bell hums,
            the hanging moonlight,
            glows red in silence.
            HEREDOC

            puts poem
          elsif parsed_tokens[0] == "srouge" # shijimarouge
            new_index  = 0
            size_limit = parsed_tokens.size.to_i
          
